<?xml version="1.0" encoding="utf-8"?>
<resources >

    <!-- Main Style -->

    <style name="ButtonMainStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/zero_dp</item>
        <item name="android:layout_marginBottom">@dimen/indent_30</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">?attr/colorOnPrimary</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/indent_8</item>
        <item name="iconTint">@color/yp_black</item>
    </style>

    <!-- Setting Style -->

    <style name="TextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/settings_item_height</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">@dimen/text_content</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
    </style>

    <!-- Switch Thing Style -->

    <style name="SwitchSettingStyle" parent="TextStyle">
        <item name="thumbTint">?attr/thumbTint</item>
        <item name="trackTint">?attr/trackTint</item>
    </style>

</resources>
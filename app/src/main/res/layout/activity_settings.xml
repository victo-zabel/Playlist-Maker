<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSecondary"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/indent_16"
    android:paddingTop="@dimen/indent_14">

    <LinearLayout style="@style/ContainerStyle"
        android:layout_marginBottom="@dimen/indent_24">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/IconButtonStyle" />

        <TextView
            style="@style/TitleStyle"
            android:text="@string/setting" />
    </LinearLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/theme_switcher"
        android:text="@string/dark_theme"
        style="@style/SwitchSettingStyle" />

    <TextView
        android:id="@+id/btn_share"
        android:text="@string/share"
        style="@style/TextStyle"
        app:drawableEndCompat="@drawable/ic_share" />

    <TextView
        android:id="@+id/btn_support"
        android:text="@string/support"
        style="@style/TextStyle"
        app:drawableEndCompat="@drawable/ic_support" />

    <TextView
        android:id="@+id/btn_agreement"
        android:text="@string/users_agree"
        style="@style/TextStyle"
        app:drawableEndCompat="@drawable/ic_arrow_forward" />

</LinearLayout>
